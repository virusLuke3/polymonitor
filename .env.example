# ============================================================
# 环境变量示例（可提交到 GitHub）
# 使用方式：复制为 .env 后填入真实值，.env 不要提交
# 注意：本文件只保留占位符，不放真实地址、端口、URL、密钥
# ============================================================

# ============================================================
# Polygon / Indexer
# ============================================================

# POLYMARKET_RPC_URL=<configure_in_private_env>
# POLYDATA_POLYGON_RPC_SSH_TARGET=
# POLYDATA_POLYGON_RPC_SSH_IDENTITY_FILE=
# POLYDATA_POLYGON_RPC_LOCAL_PORT=<local_ssh_forward_port>
# POLYDATA_POLYGON_RPC_REMOTE_PORT=<remote_bor_loopback_port>
# POLYDATA_POLYGON_RPC_MAX_LAG_BLOCKS=<maximum_accepted_sync_lag>
# POLYMARKET_DB=<your_indexer_db_path>
# POLYMARKET_DB_BACKEND=<your_db_backend>

# ============================================================
# Database / MySQL
# ============================================================

# POLYMARKET_MYSQL_HOST=<your_mysql_host>
# POLYMARKET_MYSQL_PORT=<your_mysql_port>
# POLYMARKET_MYSQL_USER=<your_mysql_user>
# POLYMARKET_MYSQL_PASSWORD=
# POLYMARKET_MYSQL_DATABASE=<your_mysql_database>
# POLYMARKET_MYSQL_CHARSET=<your_mysql_charset>

# ============================================================
# API Server / Frontend
# ============================================================

# POLYDATA_API_HOST=<your_api_host>
# POLYDATA_API_PORT=<your_api_port>
# POLYDATA_ALLOWED_ORIGINS=<comma_separated_allowed_origins>
# VITE_POLYDATA_API_BASE_URL=<your_frontend_api_base_url>
# POLYDATA_PUBLIC_WEB_URL=<your_frontend_web_url>

# ============================================================
# Redis / Snapshot
# ============================================================

# POLYDATA_REDIS_URL=<your_redis_url>
# POLYDATA_REDIS_PREFIX=<your_redis_prefix>
# Public seeds use a dedicated local Redis; existing Redis queues stay separate.
# POLYMONITOR_SEED_REDIS_URL=<your_seed_redis_url>
# POLYMONITOR_SEED_REDIS_PREFIX=<shared_seed_prefix_for_all_collectors_and_api>
# POLYMONITOR_SEED_BACKEND=redis
# POLYDATA_SNAPSHOT_SQLITE_PATH=<your_snapshot_sqlite_path>
# POLYDATA_SNAPSHOT_PREWARM=<enable_or_disable_snapshot_prewarm>

# ============================================================
# API 缓存 / Runtime TTL
# ============================================================

# POLYDATA_DASHBOARD_CACHE_TTL_SECONDS=<dashboard_cache_ttl_seconds>
# POLYDATA_MARKETS_CACHE_TTL_SECONDS=<markets_cache_ttl_seconds>
# POLYDATA_DASHBOARD_TRADE_WINDOW=<dashboard_trade_window>
# POLYDATA_ADDRESS_CACHE_TTL_SECONDS=<address_cache_ttl_seconds>
# POLYDATA_FINANCE_RUNTIME_TTL_SECONDS=<finance_runtime_ttl_seconds>
# POLYDATA_FINANCE_DEFILLAMA_YIELDS_URL=<configure_in_private_env>
# POLYDATA_FINANCE_ALTERNATIVE_FNG_URL=<configure_in_private_env>
# POLYDATA_FINANCE_GOOGLE_NEWS_RSS_URL=<configure_in_private_env>
# POLYDATA_FINANCE_YAHOO_CHART_URL_TEMPLATE=<configure_in_private_env>
# POLYDATA_FINANCE_FRED_CSV_URL_TEMPLATE=<configure_in_private_env>
# POLYDATA_FRED_CSV_LOOKBACK_YEARS=4
# POLYDATA_FINANCE_BARCHART_QUOTE_URL_TEMPLATE=<configure_in_private_env>
# POLYDATA_FINANCE_CNN_FNG_URL=<configure_in_private_env>
# POLYDATA_FINANCE_CNN_FNG_REFERER_URL=<configure_in_private_env>
# POLYDATA_FINANCE_AAII_SENTIMENT_URL=<configure_in_private_env>
# POLYDATA_FINANCE_BROKER_RESEARCH_FEED_URLS=<comma_separated_original_research_json_or_rss_urls>
POLYDATA_FINANCE_BROKER_RESEARCH_FEED_URLS=
# POLYDATA_FINANCE_BROKER_RESEARCH_NEWS_FALLBACK=false
# POLYDATA_FINANCE_BROKER_RESEARCH_EDISON_URL=<configure_in_private_env>
# POLYDATA_FINANCE_BROKER_RESEARCH_ZACKS_URL=<configure_in_private_env>
# POLYDATA_FINANCE_BROKER_RESEARCH_WATER_TOWER_URL=<configure_in_private_env>
# POLYDATA_FINANCE_BROKER_RESEARCH_EASTMONEY_URL=<authorized_eastmoney_research_metadata_or_listing_url>
# POLYDATA_FINANCE_BROKER_RESEARCH_CHOICE_URL=<authorized_choice_research_metadata_or_listing_url>
# POLYDATA_FINANCE_HYPERLIQUID_INFO_URL=<configure_in_private_env>
# POLYDATA_FINANCE_OKX_MARKET_TICKER_URL=<configure_in_private_env>
# POLYDATA_FINANCE_DEFILLAMA_STABLECOINS_URL=<configure_in_private_env>
# POLYDATA_FINANCE_CFTC_LEGACY_COT_URL=<configure_in_private_env>
# POLYDATA_SPORTS_RUNTIME_TTL_SECONDS=<sports_runtime_ttl_seconds>
# POLYDATA_SIGNAL_RUNTIME_TTL_SECONDS=300

# ============================================================
# 外部 API 来源
# ============================================================

# POLYDATA_CLOB_WS_URL=<your_clob_websocket_url>
# POLYDATA_GAMMA_API_BASE=<your_gamma_api_base_url>
# POLYDATA_POLYMARKET_DATA_API_BASE=<your_polymarket_data_api_base_url>
# POLYDATA_POLYMARKET_ACTIVITY_API_URL=<your_polymarket_activity_api_url>
# POLYDATA_YAHOO_CHART_BASE_URL=<your_market_chart_provider_url>
# POLYDATA_COINGECKO_BASE_URL=<your_crypto_provider_url>
# POLYDATA_ESPN_NBA_BASE_URL=<your_sports_news_provider_url>
# POLYDATA_ESPN_CORE_NBA_BASE_URL=<your_sports_predictor_provider_url>
# POLYDATA_NBA_LINEUPS_BASE_URL=<your_nba_lineups_provider_url>
# POLYDATA_NBA_OFFICIAL_BASE_URL=<your_nba_official_site_url>
# POLYDATA_GRID_API_KEY=
# grid_api_key=<optional_local_alias_for_grid_api_key>
# POLYDATA_GRID_ESPORTS_PM_SEARCH_ENABLED=false
# POLYDATA_THE_ODDS_API_KEY=
# the_odds_api_key=<optional_local_alias_for_the_odds_api_key>
# POLYDATA_SPORTS_ODDS_PM_SEARCH_ENABLED=false
# Shared Sports / Game odds owner; configure only sources you intend to enable.
# Copy public endpoints from provider docs into private .env, never into scripts.
POLYDATA_ODDSLINK_TRY_URL=
POLYDATA_ODDSLINK_PUBLIC_BOARD_URL=
POLYDATA_MOVIODDS_BASE_URL=
POLYDATA_MOVIODDS_API_KEY=
# Comma-separated, verified match sports. Unset retains the original seven.
# Other supported projects: rugby_union,rugby_league,cricket,australian_rules,
# table_tennis,volleyball,handball,badminton,boxing,mma,darts,snooker,bandy,floorball,gaelic_sports
POLYDATA_MOVIODDS_SPORTS=
# Optional stream endpoint; enable with the flag below. No implicit endpoint or personal key.
POLYDATA_MOVIODDS_WS_URL=
# Permanent stream + historical owner. Disabled unless explicitly enabled.
POLYDATA_MOVIODDS_STREAM_ENABLED=
POLYDATA_MOVIODDS_ARCHIVE_PATH=
POLYDATA_MOVIODDS_ARCHIVE_MAX_MIB=
POLYDATA_MOVIODDS_RAW_RETENTION_DAYS=
POLYDATA_MOVIODDS_HISTORY_RETENTION_DAYS=
POLYDATA_MOVIODDS_LOOKBACK_DAYS=
# Bounded per-round REST work; one shared WS uses the configured source routes.
POLYDATA_MOVIODDS_REST_REQUESTS_PER_CYCLE=
POLYDATA_PINNACLE_GUEST_BASE_URL=
POLYDATA_PINNACLE_PUBLIC_CONFIG_URL=
POLYDATA_PINNACLE_GUEST_API_KEY=
# Shared durable guest quota ledger for research and production processes.
POLYDATA_BOOKMAKER_QUOTA_SQLITE_PATH=
# Shared bookmaker matching: private state, no new source collection.
POLYDATA_ODDS_MATCH_DB_PATH=
POLYDATA_ODDS_MATCH_MAX_MIB=
POLYDATA_ODDS_MATCH_RETENTION_DAYS=
POLYDATA_ODDS_MATCH_INTERVAL_SECONDS=
POLYDATA_ODDS_MATCH_JOBS=
# JSON list: sport, stable entity, names list, evidence (no guessed aliases).
POLYDATA_ODDS_MATCH_ALIASES_JSON=
# HTTPS display URL with {event_slug} and optionally {slug} for a child market.
POLYDATA_ODDS_MATCH_MARKET_URL_TEMPLATE=
POLYDATA_ODDSLINK_TRY_PAGE_URL=
POLYDATA_KASHROCK_DEMO_PROPS_URL=
POLYDATA_KASHROCK_PUBLIC_URL=
POLYDATA_PINNODDS_PUBLIC_ESPORTS_URL=
POLYDATA_PINNODDS_PUBLIC_BOARD_URL=
POLYDATA_FANDUEL_PUBLIC_URL=
# Public application identifier, still kept out of source code / browser payloads.
POLYDATA_FANDUEL_PUBLIC_APP_KEY=
POLYDATA_BOVADA_PUBLIC_URL=
POLYDATA_BETRIVERS_PUBLIC_URL=
POLYDATA_ODDSPORTAL_PUBLIC_URL=
POLYDATA_ODDSPORTAL_BOOKMAKERS_URL=
POLYDATA_ODDSPORTAL_LOL_URL=
# Capability audit of the client-rendered esports directory (not a feed).
POLYDATA_ODDSPORTAL_ESPORTS_URL=
# Research probes only; failed access does not enable a production collector.
POLYDATA_ODDSLINK_PUBLIC_SPORTS_URL=
POLYDATA_DRAFTKINGS_PUBLIC_URL=
POLYDATA_BETMGM_PUBLIC_CONFIG_URL=
POLYDATA_CAESARS_PUBLIC_URL=
POLYDATA_ODDSCHECKER_PUBLIC_URL=
# Authenticated alternatives require your own account key and adapter validation.
POLYDATA_ODDSPAPI_API_KEY=
POLYDATA_ODDSLINK_API_KEY=
POLYDATA_KASHROCK_API_KEY=
POLYDATA_PINNODDS_API_KEY=
# Uses POLYMONITOR_SOURCE_ROUTES_JSON and POLYDATA_SNAPSHOT_SQLITE_PATH.
# Missing routes use direct access with environment proxy inheritance disabled.
