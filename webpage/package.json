{
  "name": "polydata-world-terminal",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "check:locales": "node scripts/check-locales.mjs",
    "check:map-bundle": "node scripts/check-map-bundle.mjs",
    "test:map": "vitest run src/features/world-event-map",
    "test:map:e2e": "playwright test e2e/world-event-map.spec.ts",
    "perf:map": "node scripts/measure-map-performance.mjs",
    "build": "npm run check:locales && npm run check:boundaries && tsc && vite build && npm run check:map-bundle",
    "preview": "vite preview",
    "check:boundaries": "node scripts/check-frontend-boundaries.mjs",
    "test:unit": "vitest run src",
    "test:frontend:e2e": "playwright test e2e/frontend-lifecycle.spec.ts e2e/frontend-architecture.spec.ts e2e/panel-styles.spec.ts",
    "test:browser": "playwright test",
    "preview:map-alignment": "POLYDATA_READONLY_PREVIEW=1 VITE_POLYDATA_API_BASE_URL=/wm-api VITE_POLYDATA_PROXY_TARGET=https://polymonitor.club/wm-api POLYDATA_MAP_TILES_TARGET=https://polymonitor.club/map-tiles VITE_PMTILES_URL=/map-tiles/planet.pmtiles vite --host 127.0.0.1 --port 4191 --strictPort",
    "preview:map-fixtures": "MAP_ALIGNMENT_PHASE=preview MAP_ALIGNMENT_PREVIEW=1 VITE_PMTILES_URL=/map-tiles/planet.pmtiles playwright test e2e/map-alignment.spec.ts --grep 'alignment en' --headed"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "d3-geo": "^3.1.1",
    "globe.gl": "^2.45.3",
    "hls.js": "^1.6.16",
    "lightweight-charts": "^5.2.0",
    "maplibre-gl": "^6.4.1",
    "pmtiles": "^4.4.1",
    "preact": "^10.26.4",
    "supercluster": "^8.0.1",
    "three": "^0.183.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@preact/preset-vite": "^2.10.2",
    "@types/d3-geo": "^3.1.0",
    "@types/supercluster": "^7.1.3",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
