server {
    listen 80;
    server_name __POLYDATA_SERVER_NAME__ _;

    root /var/www/polydata;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        application/json
        application/javascript
        application/xml
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # The browser Operations Workspace is intentionally not part of the
    # product surface. Runtime collectors and protected API endpoints remain
    # available to operators without publishing a frontend route.
    location = /operations {
        return 404;
    }

    location ^~ /operations/ {
        return 404;
    }

    # Agent endpoints call paid LLM APIs. Keep them out of the public web
    # surface; use the loopback API or an authenticated private tunnel instead.
    location ^~ /wm-api/agent/ {
        return 403;
    }

    # Same-origin Range proxy for the ranked Protomaps/PMTiles basemap. The
    # upstream CDN only grants CORS to WorldMonitor itself, so browsers must
    # not request it directly from the Polymonitor origin.
    location = /map-tiles/planet.pmtiles {
        proxy_pass https://maps.worldmonitor.app/planet.pmtiles;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host maps.worldmonitor.app;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_force_ranges on;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # The connection zone is declared by
    # /etc/nginx/conf.d/polydata-lob-limits.conf. Bound slow LOB reads per
    # client so they cannot consume every main API request slot.
    location ^~ /wm-api/runtime/lob/ {
        limit_conn polydata_lob_conn 4;
        limit_conn_status 429;
        proxy_pass __POLYDATA_API_UPSTREAM__/runtime/lob/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /wm-api/ {
        proxy_pass __POLYDATA_API_UPSTREAM__/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
