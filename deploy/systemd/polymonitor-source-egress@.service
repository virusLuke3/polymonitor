[Unit]
Description=Polymonitor isolated external-source SSH route (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=POLYMONITOR_ENV_FILE=/__POLYMONITOR_ENV_FILE__
ExecStart=/__POLYDATA_PYTHON_BIN__ /__POLYDATA_REPO_ROOT__/scripts/runtime/source_egress.py --node %i
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
