[Unit]
Description=External Polymonitor public availability probe
After=network-online.target
Wants=network-online.target
ConditionEnvironment=!POLYDATA_DEPLOY_ROLE=gcp-api

[Service]
Type=oneshot
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec "${POLYDATA_PYTHON_BIN:-python3}" scripts/ops/probe_public_availability.py --output "${POLYDATA_EXTERNAL_MONITOR_OUTPUT:-%S/polydata-external-monitor/availability.json}"'
TimeoutStartSec=45
UMask=0077
StateDirectory=polydata-external-monitor
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/polydata-external-monitor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
