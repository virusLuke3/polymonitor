[Unit]
Description=polyData PostgreSQL reverse tunnel healthcheck
After=network-online.target polydata-db-reverse-tunnel.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/polydata/polydata.env
WorkingDirectory=/__POLYDATA_REPO_ROOT__
ExecStart=/__POLYDATA_REPO_ROOT__/scripts/ops/postgres_reverse_tunnel_healthcheck.sh
TimeoutStartSec=90
UMask=0077
