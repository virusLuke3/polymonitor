# Public collectors run without credentials. Keep these values out of source control.
POLYDATA_SNAPSHOT_SQLITE_PATH=/__POLYDATA_DATA_ROOT__/panel_snapshots.sqlite3
# Empty means direct access. Never change the user's main Clash selection.
POLYMONITOR_POLITICS_PROXY_URL=
# Optional exact GovInfo bill IDs, comma separated. P.L.119-103's bill is tracked by default.
POLYMONITOR_POLITICS_BILLS=119hr6500
# Reserved credential names. Authentication alone does not establish source coverage.
# Licensed AP elections, Congress nominations and FEC transaction adapters require
# field-level acceptance with the configured account before replacing public data.
POLYMONITOR_AP_ELECTIONS_API_KEY=
POLYMONITOR_CONGRESS_API_KEY=
POLYMONITOR_FEC_API_KEY=
