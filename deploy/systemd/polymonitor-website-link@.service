[Unit]
Description=Polymonitor isolated website data link (%i)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
Environment=POLYMONITOR_ENV_FILE=/__POLYDATA_REPO_ROOT__/.env
ExecStart=/usr/bin/python3 /__POLYDATA_REPO_ROOT__/scripts/runtime/website_link.py --profile %i
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
