[Unit]
Description=polyData API service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'POLYDATA_LOB_WEBSOCKET_ENABLED="${POLYDATA_API_LOB_WEBSOCKET_ENABLED:-0}" exec "${POLYDATA_PYTHON_BIN:-python3}" scripts/api_server.py --backend postgres --skip-init-schema --host "${POLYDATA_API_HOST:-127.0.0.1}" --port "${POLYDATA_API_PORT:-18500}"'
Restart=always
RestartSec=15
TimeoutStopSec=45
KillMode=mixed
OOMPolicy=kill
CPUQuota=180%
MemoryHigh=2G
MemoryMax=3G
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target
