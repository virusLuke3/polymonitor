[Unit]
Description=polyData PostgreSQL reverse tunnel to GCP API host
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/polydata/polydata.env
ExecCondition=/bin/bash -lc 'test -n "${POLYDATA_GCP_SSH_TARGET:-}"'
ExecStartPre=-/bin/bash -lc 'timeout 20s ssh -o BatchMode=yes -o ConnectTimeout=8 -o ConnectionAttempts=1 -o IPQoS=none -o KexAlgorithms=curve25519-sha256 "${POLYDATA_GCP_SSH_TARGET}" "for port in ${POLYDATA_REMOTE_POSTGRES_PORT:-45432} ${POLYDATA_REMOTE_CLICKHOUSE_HTTP_PORT:-18123}; do sudo -n fuser -k ${port}/tcp >/dev/null 2>&1 || fuser -k ${port}/tcp >/dev/null 2>&1 || true; done"'
ExecStart=/bin/bash -lc 'exec ssh -N -R "127.0.0.1:${POLYDATA_REMOTE_POSTGRES_PORT:-45432}:127.0.0.1:${POLYDATA_LOCAL_POSTGRES_PORT:-45432}" -R "127.0.0.1:${POLYDATA_REMOTE_CLICKHOUSE_HTTP_PORT:-18123}:127.0.0.1:${POLYDATA_LOCAL_CLICKHOUSE_HTTP_PORT:-18123}" -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=1 -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o TCPKeepAlive=yes -o IPQoS=none -o KexAlgorithms=curve25519-sha256 "${POLYDATA_GCP_SSH_TARGET}"'
Restart=always
RestartSec=8

[Install]
WantedBy=polydata-local-collector.target
