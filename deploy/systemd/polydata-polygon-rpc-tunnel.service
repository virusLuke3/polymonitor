[Unit]
Description=polyData SSH tunnel to self-hosted Polygon Bor RPC
After=network-online.target
Wants=network-online.target
Before=polydata-trade-sync.service polydata-oracle-sync.service
StartLimitIntervalSec=0

[Service]
StandardOutput=journal
StandardError=journal
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec scripts/ops/run_polygon_rpc_tunnel.sh'
Restart=always
RestartSec=8

[Install]
WantedBy=polydata-local-collector.target
